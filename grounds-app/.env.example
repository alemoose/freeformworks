# Generate a separate secret per environment. Never commit populated secrets.
GROUNDS_SECRET_KEY=
# Local only (absolute path recommended):
DATABASE_URL=sqlite:////tmp/grounds-local.db
# Production must use PostgreSQL; require TLS per your provider's instructions:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# GROUNDS_ENV=production
