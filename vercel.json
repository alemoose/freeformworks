{
  "redirects": [
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/book.html",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/sample.html",
      "destination": "/sample",
      "permanent": true
    },
    {
      "source": "/leads.html",
      "destination": "/leads",
      "permanent": true
    },
    {
      "source": "/index.html/book.html",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/index.html/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/sample",
      "destination": "/sample.html"
    },
    {
      "source": "/leads",
      "destination": "/leads.html"
    },
    {
      "source": "/work",
      "destination": "/index.html"
    },
    {
      "source": "/build",
      "destination": "/index.html"
    },
    {
      "source": "/principles",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/leads",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/leads.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/leads.js": {
      "maxDuration": 60
    }
  }
}
